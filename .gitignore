.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.vscode/
.env
*.log
data/raw/*
data/processed/*
outputs/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!outputs/.gitkeep
# Track submission visuals and the contest draft package. Scratch under outputs/eda stays ignored.
# Contest ZIP and oral-round slides stay local or on Drive output. Do not track them.
!outputs/infographic/
!outputs/submission/
# Excel zip files are generated locally. Committing them from Windows corrupted the zip.
outputs/submission/**/*.xlsx
# Hangul-authored report and official export. Keep local or on Drive.
outputs/submission/**/*.hwpx
outputs/submission/**/*-official.pdf
# Korean-filename template copy. The tracked original uses an ASCII name.
docs/templates/*.hwpx
!docs/templates/2026-big-data-competition-submission-template.hwpx
